# ══════════════════════════════════════════════════════════════
# Rekonect — variables de PRODUCTION (Scaleway)
#   cp .env.production.example .env.production   (ignoré par git, jamais commité)
#   staging : même chose dans .env.staging
#
# Un seul fichier pour les quatre conteneurs : deploy-local.sh répartit (infrastructure/scaleway/lib.sh)
#   api, worker      → tout, sauf NEXT_PUBLIC_*, VITE_* et DIRECT_URL
#   admin, partners  → les NEXT_PUBLIC_* seulement
# Une valeur par ligne. Les JSON (FCM) sur une seule ligne : jq -c . fichier.json
# deploy-local.sh refuse d'envoyer un fichier incohérent (URL locales, CORS incomplet, pooler…).
# ══════════════════════════════════════════════════════════════

NODE_ENV=production
APP_ENV=production
APP_TIMEZONE=Europe/Paris

# ─── URL publiques (sans / final) ───
# Avant les domaines personnalisés : les domaines natifs affichés par setup.sh
# (https://<namespace>-api.functions.fnc.fr-par.scw.cloud…). Voir domains.sh pour la bascule.
PUBLIC_API_URL=https://api.rekonect.app
WEB_ADMIN_URL=https://admin.rekonect.app
WEB_PARTNERS_URL=https://partenaires.rekonect.app
MOBILE_APP_URL=rekonect://
# Les deux fronts : URL de l'API, substituée au démarrage du conteneur (une image pour tous les env.)
NEXT_PUBLIC_API_URL=https://api.rekonect.app
# Fronts + app mobile (Capacitor iOS : capacitor://localhost, Android : http://localhost)
CORS_ORIGINS=https://admin.rekonect.app,https://partenaires.rekonect.app,capacitor://localhost,http://localhost

# ─── Base Postgres (Supabase) ───
# Pooler en mode SESSION (port 5432 sur *.pooler.supabase.com) : LISTEN/NOTIFY y fonctionne.
# PAS le mode transaction (6543, pgbouncer=true) : temps réel et réveil du worker cassés.
# Supabase › Connect › « Session pooler ».
DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# Facultatif : connexion utilisée par ce poste pour pg_dump et les migrations (sinon DATABASE_URL).
# DIRECT_URL=
# Connexions par processus. Au pic : (2 API + 1 worker) × (pool + 1) doit tenir dans le pool du
# projet Supabase (Settings › Database › Pool size). 5 → 18 connexions.
DATABASE_POOL_MAX=5

# ─── Sessions ───
# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
CHILD_REFRESH_TTL_DAYS=180

# ─── Notifications ───
NOTIFICATIONS_ENGINE=api
CATALOG_AGE_FILTER=false
# Push iOS : clé .p8 en base64 sur une ligne (base64 -i AuthKey_XXXX.p8 | tr -d '\n')
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=ceo.services.rekonect
# Push Android : compte de service Firebase, JSON sur une ligne
FCM_SERVICE_ACCOUNT_JSON=

# ─── Emails (Brevo) ───
BREVO_API_KEY=
EMAIL_FROM=noreply@rekonect.app
EMAIL_FROM_NAME=Rekonect
# Équipe prévenue à chaque demande « Être rappelé » de la landing partenaires (vide : pas d'alerte)
PARTNER_LEADS_EMAIL=

# ─── Stripe ───
# Webhook à déclarer dans Stripe : <PUBLIC_API_URL>/v1/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Transition mobile ───
# Anciennes versions de l'app encore sur Supabase Auth : vider quand tous les appareils ont mis à jour.
SUPABASE_JWT_SECRET=
