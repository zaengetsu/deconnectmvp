# Réglages de livraison : copiez ce fichier en ~/.rekonect/release.env (ou .release.env à la racine, ignoré par git).

# ─── TestFlight (scripts/testflight.sh) ───
# Clé API App Store Connect : appstoreconnect.apple.com → Users and Access → Integrations.
# Le fichier AuthKey_<ASC_KEY_ID>.p8 va dans ~/.private_keys/ (ou indiquez ASC_KEY_PATH).
ASC_KEY_ID=
ASC_ISSUER_ID=
# ASC_KEY_PATH=~/.private_keys/AuthKey_XXXXXXXXXX.p8
# TEAM_ID=D72UK7R5RE
# PROFILE=Rekonect_AppStore

# ─── Firebase App Distribution (scripts/firebase.sh) ───
FIREBASE_ANDROID_APP_ID=1:410630450375:android:f012e7c0ddc7b92a21a2e2
# FIREBASE_IOS_APP_ID=
FIREBASE_TESTERS=leonceyopa@gmail.com,stella.berthier@yahoo.fr,i.berthier@wineor.fr
