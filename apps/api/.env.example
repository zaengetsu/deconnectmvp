# API Rekonect — copier en .env
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://rekonect:rekonect@localhost:5432/rekonect
# Base jetable des tests d'intégration (créée/détruite automatiquement)
TEST_DATABASE_URL=postgresql://rekonect:rekonect@localhost:5432/postgres

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# App mobile : capacitor://localhost (iOS) et http://localhost (Android)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:3002,capacitor://localhost,http://localhost
APP_TIMEZONE=Europe/Paris

# "sql" tant que les triggers Supabase envoient encore les notifications, "api" après la bascule.
NOTIFICATIONS_ENGINE=api

# Push
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=ceo.services.rekonect
FCM_SERVICE_ACCOUNT_JSON=

# Email (Brevo)
BREVO_API_KEY=
EMAIL_FROM=noreply@rekonect.app
EMAIL_FROM_NAME=Rekonect
# Équipe prévenue à chaque demande de la landing partenaires (vide : pas d'alerte)
PARTNER_LEADS_EMAIL=
WEB_ADMIN_URL=http://localhost:3001
WEB_PARTNERS_URL=http://localhost:3002

APP_ENV=development
# Stripe (clés test en local : sk_test_… / whsec_… via `stripe listen --forward-to localhost:3000/v1/billing/webhook`)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Uniquement pour les anciennes versions de l'app encore connectées via Supabase Auth (Settings → API → JWT Secret).
# La version actuelle n'utilise que les jetons de l'API : laisser vide une fois tous les appareils mis à jour.
SUPABASE_JWT_SECRET=
