  impressions       OfferImpression[]

  @@index([partnerId, status], map: "partner_offers_partner_idx")
  @@map("partner_offers")
}

model OfferClaim {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offerId           String         @map("offer_id") @db.Uuid
  parentId          String         @map("parent_id") @db.Uuid
  childId           String?        @map("child_id") @db.Uuid
  rewardRequestId   String?        @map("reward_request_id") @db.Uuid
  sourceKey         String         @map("source_key")
  status            String         @default("unlocked")
  code              String?
  unlockedAt        DateTime       @default(now()) @map("unlocked_at") @db.Timestamptz(6)
  redeemedAt        DateTime?      @map("redeemed_at") @db.Timestamptz(6)
  expiresAt         DateTime?      @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  redeemedPlaceId   String?        @map("redeemed_place_id") @db.Uuid
  redeemedBy        String?        @map("redeemed_by") @db.Uuid
  basketAmountCents Int?           @map("basket_amount_cents")
  redeemedPlace     PartnerPlace?  @relation(fields: [redeemedPlaceId], references: [id], onUpdate: NoAction)
  offer             PartnerOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  parent            Profile        @relation(fields: [parentId], references: [id], onDelete: Cascade)
  child             Child?         @relation(fields: [childId], references: [id], onUpdate: NoAction)
  rewardRequest     RewardRequest? @relation(fields: [rewardRequestId], references: [id], onUpdate: NoAction)
  codes             VoucherCode[]

  @@unique([offerId, sourceKey], map: "offer_claims_source_key")
  @@index([parentId, status], map: "offer_claims_parent_idx")
  @@map("offer_claims")
}

model VoucherCode {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offerId    String       @map("offer_id") @db.Uuid
  code       String
  status     String       @default("available")
  claimId    String?      @map("claim_id") @db.Uuid
  assignedAt DateTime?    @map("assigned_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  offer      PartnerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  claim      OfferClaim?  @relation(fields: [claimId], references: [id], onUpdate: NoAction)

  @@unique([offerId, code], map: "voucher_codes_offer_code_key")
  @@map("voucher_codes")
}

model OfferMetricDaily {
  offerId     String       @map("offer_id") @db.Uuid
  day         DateTime     @db.Date
  views       Int          @default(0)
  unlocks     Int          @default(0)
  redemptions Int          @default(0)
  offer       PartnerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@id([offerId, day])
  @@map("offer_metrics_daily")
}

model OfferImpression {
  offerId   String       @map("offer_id") @db.Uuid
  viewerKey String       @map("viewer_key")
  day       DateTime     @db.Date
  offer     PartnerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@id([offerId, viewerKey, day])
  @@map("offer_impressions")
}

model MediaFile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// offer : visuel partenaire (public) · proof : preuve d'activité d'un enfant.
  kind        String   @default("offer")
  childId         String? @map("child_id") @db.Uuid
  childActivityId String? @map("child_activity_id") @db.Uuid
  partnerId   String?  @map("partner_id") @db.Uuid
  uploadedBy  String?  @map("uploaded_by") @db.Uuid
  contentType String   @map("content_type")
  size        Int
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  partner     Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId], map: "media_files_partner_idx")
  @@index([childActivityId], map: "media_files_child_activity_idx")
  @@map("media_files")
}

/// File d'envoi et journal des emails automatiques : idempotence (dedup_key), reprises, désinscription.
model EmailMessage {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template      String
  category      String
  audience      String
  toEmail       String    @map("to_email")
  toName        String?   @map("to_name")
  subject       String
  data          Json      @default("{}")
  recipientId   String?   @map("recipient_id") @db.Uuid
  dedupKey      String?   @unique(map: "email_messages_dedup_key") @map("dedup_key")
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  providerId    String?   @map("provider_id")
  lastError     String?   @map("last_error")
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt], map: "email_messages_pending_idx")
  @@index([toEmail, createdAt], map: "email_messages_to_idx")
  @@map("email_messages")
}

/// Désinscriptions par adresse et catégorie (les emails de sécurité, compte et facturation ne sont pas concernés).
model EmailSuppression {
  email     String
  category  String
  source    String   @default("link")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([email, category])
  @@map("email_suppressions")
}
