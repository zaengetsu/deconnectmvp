// Schéma Prisma de Rekonect.
// Les tables existantes conservent leurs noms snake_case (@@map / @map) : le schéma est
// compatible octet pour octet avec la base Supabase actuelle (voir prisma/migrations).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Identité ────────────────────────────────────────────────────────────────

model User {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String          @unique(map: "users_email_key")
  passwordHash    String?         @map("password_hash")
  role            String          @default("parent")
  fullName        String?         @map("full_name")
  emailVerifiedAt DateTime?       @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?       @map("last_login_at") @db.Timestamptz(6)
  disabledAt      DateTime?       @map("disabled_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshTokens   RefreshToken[]
  partnerMembers  PartnerMember[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  childId    String?   @map("child_id") @db.Uuid
  tokenHash  String    @unique(map: "refresh_tokens_token_hash_key") @map("token_hash")
  familyId   String    @map("family_id") @db.Uuid
  deviceId   String?   @map("device_id")
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  child      Child?    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([familyId], map: "refresh_tokens_family_idx")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique(map: "password_reset_tokens_token_key")
  expiresAt DateTime  @default(dbgenerated("(now() + '01:00:00'::interval)")) @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("password_reset_tokens")
}

// ─── Familles ────────────────────────────────────────────────────────────────

model Profile {
  id          String    @id @db.Uuid
  email       String
  fullName    String?   @map("full_name")
  role        String    @default("parent")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  parentRole  String?   @default("parent") @map("parent_role")
  avatarEmoji String?   @default("👤") @map("avatar_emoji")
  country     String?   @default("FR")
  city        String?
  postalCode  String?   @map("postal_code")
  region      String?
  latitude    Float?
  longitude   Float?

  children                Child[]
  createdActivities       Activity[]               @relation("ActivityCreatedBy")
  rewards                 Reward[]
  subscriptions           Subscription[]
  notificationPreferences NotificationPreference[]
  pushTokens              PushToken[]
  familyGoals             FamilyGoal[]
  familyRituals           FamilyRitual[]
  familyInvitations       FamilyInvitation[]
  ownedFamilyMembers      FamilyMember[]           @relation("FamilyOwner")
  memberships             FamilyMember[]           @relation("FamilyMember")
  childInvitations        ChildInvitation[]
  childLinkTokens         ChildLinkToken[]
  offerClaims             OfferClaim[]
  assignedActivities      ChildActivity[]          @relation("AssignedBy")
  validatedActivities     ChildActivity[]          @relation("ValidatedBy")
  handledRewardRequests   RewardRequest[]
  ledgerEntries           PointsLedger[]
  subscriptionEvents      SubscriptionEvent[]
  invoices                Invoice[]
  promoRedemptions        PromoRedemption[]
  activityReports         ActivityReport[]

  @@map("profiles")
}

model Child {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId          String    @map("parent_id") @db.Uuid
  displayName       String    @map("display_name")
  age               Int
  avatarUrl         String?   @map("avatar_url")
  totalPoints       Int       @default(0) @map("total_points")
  level             Int       @default(1)
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  pinHash           String?   @map("pin_hash")
  streakDays        Int       @default(0) @map("streak_days")
  lastActivityDate  DateTime? @map("last_activity_date") @db.Date
  authUserId        String?   @map("auth_user_id") @db.Uuid
  deviceLinkedAt    DateTime? @map("device_linked_at") @db.Timestamptz(6)
  failedPinAttempts Int       @default(0) @map("failed_pin_attempts")
  pinLockedUntil    DateTime? @map("pin_locked_until") @db.Timestamptz(6)

  parent                  Profile                  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  activities              ChildActivity[]
  badges                  ChildBadge[]
  ledger                  PointsLedger[]
  rewardRequests          RewardRequest[]
  rewards                 Reward[]
  pushTokens              PushToken[]
  notificationPreferences NotificationPreference[]
  screenTime              ScreenTimeDaily[]
  linkTokens              ChildLinkToken[]
  invitations             ChildInvitation[]
  refreshTokens           RefreshToken[]
  friendsInitiated        ChildFriend[]            @relation("FriendInitiator")
  friendsReceived         ChildFriend[]            @relation("FriendTarget")
  duosInitiated           DuoChallenge[]           @relation("DuoInitiator")
  duosPartnered           DuoChallenge[]           @relation("DuoPartner")
  actorNotifications      Notification[]
  offerClaims             OfferClaim[]

  @@map("children")
}

model FamilyMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  memberId    String?   @map("member_id") @db.Uuid
  memberEmail String    @map("member_email")
  memberRole  String    @default("co_parent") @map("member_role")
  childIds    String[]  @map("child_ids") @db.Uuid
  status      String    @default("pending")
  invitedAt   DateTime? @default(now()) @map("invited_at") @db.Timestamptz(6)
  joinedAt    DateTime? @map("joined_at") @db.Timestamptz(6)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  owner       Profile   @relation("FamilyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  member      Profile?  @relation("FamilyMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@map("family_members")
}

model FamilyInvitation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  memberRole  String    @default("co_parent") @map("member_role")
  inviteEmail String?   @map("invite_email")
  token       String    @unique(map: "family_invitations_token_key") @default(dbgenerated("encode(gen_random_bytes(20), 'hex'::text)"))
  /// Code court à 6 caractères, saisi dans l'app par le co-parent.
  shortCode   String?   @map("short_code")
  status      String    @default("pending")
  expiresAt   DateTime  @default(dbgenerated("(now() + '7 days'::interval)")) @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  owner       Profile   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("family_invitations")
}

model ChildInvitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId    String    @map("child_id") @db.Uuid
  parentId   String    @map("parent_id") @db.Uuid
  method     String
  recipient  String
  token      String    @unique(map: "child_invitations_token_key")
  status     String    @default("pending")
  expiresAt  DateTime  @default(dbgenerated("(now() + '7 days'::interval)")) @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  child      Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  parent     Profile   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@map("child_invitations")
}

model ChildLinkToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId   String    @map("child_id") @db.Uuid
  parentId  String    @map("parent_id") @db.Uuid
  token     String    @unique(map: "child_link_tokens_token_key")
  pinHash   String?   @map("pin_hash")
  deviceId  String?   @map("device_id")
  status    String    @default("pending")
  expiresAt DateTime  @default(dbgenerated("(now() + '00:15:00'::interval)")) @map("expires_at") @db.Timestamptz(6)
  linkedAt  DateTime? @map("linked_at") @db.Timestamptz(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  shortCode String?   @map("short_code")
  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  parent    Profile   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@map("child_link_tokens")
}

model Subscription {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId             String?             @map("parent_id") @db.Uuid
  partnerId            String?             @map("partner_id") @db.Uuid
  plan                 String              @default("free")
  status               String              @default("active")
  startedAt            DateTime?           @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt            DateTime?           @map("expires_at") @db.Timestamptz(6)
  stripeCustomerId     String?             @map("stripe_customer_id")
  stripeSubscriptionId String?             @map("stripe_subscription_id")
  createdAt            DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  billingInterval      String              @default("month") @map("billing_interval")
  amountCents          Int                 @default(0) @map("amount_cents")
  currency             String              @default("eur")
  stripePriceId        String?             @map("stripe_price_id")
  currentPeriodEnd     DateTime?           @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean             @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?           @map("canceled_at") @db.Timestamptz(6)
  cancelReason         String?             @map("cancel_reason")
  compPlan             String?             @map("comp_plan")
  compUntil            DateTime?           @map("comp_until") @db.Timestamptz(6)
  quantity             Int                 @default(1)
  parent               Profile?            @relation(fields: [parentId], references: [id], onDelete: Cascade)
  partner              Partner?            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  planRef              Plan                @relation("SubscriptionPlan", fields: [plan], references: [id], onUpdate: NoAction)
  compPlanRef          Plan?               @relation("SubscriptionCompPlan", fields: [compPlan], references: [id], onUpdate: NoAction)
  events               SubscriptionEvent[]

  @@map("subscriptions")
}

model Plan {
  id                   String         @id
  audience             String
  name                 String
  tagline              String?
  tag                  String?
  color                String         @default("#3C41A8")
  monthlyPriceCents    Int?           @map("monthly_price_cents")
  annualPriceCents     Int?           @map("annual_price_cents")
  currency             String         @default("eur")
  stripeProductId      String?        @map("stripe_product_id")
  stripeMonthlyPriceId String?        @map("stripe_monthly_price_id")
  stripeAnnualPriceId  String?        @map("stripe_annual_price_id")
  limits               Json           @default("{}")
  features             String[]       @default([])
  sortOrder            Int            @default(0) @map("sort_order")
  isPublic             Boolean        @default(true) @map("is_public")
  isActive             Boolean        @default(true) @map("is_active")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscriptions        Subscription[] @relation("SubscriptionPlan")
  compSubscriptions    Subscription[] @relation("SubscriptionCompPlan")
  promoCodes           PromoCode[]

  @@map("plans")
}

model SubscriptionEvent {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  parentId       String?       @map("parent_id") @db.Uuid
  partnerId      String?       @map("partner_id") @db.Uuid
  type           String
  description    String
  amountCents    Int           @default(0) @map("amount_cents")
  plan           String?
  stripeEventId  String?       @map("stripe_event_id")
  occurredAt     DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onUpdate: NoAction)
  parent         Profile?      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  partner        Partner?      @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("subscription_events")
}

model Invoice {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId        String?   @map("parent_id") @db.Uuid
  partnerId       String?   @map("partner_id") @db.Uuid
  stripeInvoiceId String?   @map("stripe_invoice_id")
  number          String?
  label           String
  amountCents     Int       @map("amount_cents")
  currency        String    @default("eur")
  status          String
  hostedUrl       String?   @map("hosted_url")
  pdfUrl          String?   @map("pdf_url")
  periodStart     DateTime? @map("period_start") @db.Timestamptz(6)
  periodEnd       DateTime? @map("period_end") @db.Timestamptz(6)
  issuedAt        DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  parent          Profile?  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  partner         Partner?  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model StripeWebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@map("stripe_webhook_events")
}

model PromoCode {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String            @unique(map: "promo_codes_code_key")
  description           String
  kind                  String
  percentOff            Int?              @map("percent_off")
  amountOffCents        Int?              @map("amount_off_cents")
  durationMonths        Int?              @map("duration_months")
  planId                String?           @map("plan_id")
  sponsorPartnerId      String?           @map("sponsor_partner_id") @db.Uuid
  maxRedemptions        Int?              @map("max_redemptions")
  redemptions           Int               @default(0)
  startsAt              DateTime?         @map("starts_at") @db.Timestamptz(6)
  expiresAt             DateTime?         @map("expires_at") @db.Timestamptz(6)
  isActive              Boolean           @default(true) @map("is_active")
  stripeCouponId        String?           @map("stripe_coupon_id")
  stripePromotionCodeId String?           @map("stripe_promotion_code_id")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  plan                  Plan?             @relation(fields: [planId], references: [id], onUpdate: NoAction)
  sponsor               Partner?          @relation(fields: [sponsorPartnerId], references: [id], onUpdate: NoAction)
  uses                  PromoRedemption[]
  targetedOffers        PartnerOffer[]

  @@map("promo_codes")
}

model PromoRedemption {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promoCodeId String    @map("promo_code_id") @db.Uuid
  parentId    String    @map("parent_id") @db.Uuid
  redeemedAt  DateTime  @default(now()) @map("redeemed_at") @db.Timestamptz(6)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  parent      Profile   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, parentId], map: "promo_redemptions_key")
  @@map("promo_redemptions")
}

// ─── Activités ───────────────────────────────────────────────────────────────

model ActivityCategory {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String         @unique(map: "activity_categories_slug_key")
  description     String?
  icon            String?
  createdAt       DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  activities      Activity[]
  offers          PartnerOffer[] @relation("OfferCategory")
  triggeredOffers PartnerOffer[] @relation("OfferTriggerCategory")

  @@map("activity_categories")
}

model Activity {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId      String?           @map("category_id") @db.Uuid
  createdBy       String?           @map("created_by") @db.Uuid
  title           String
  description     String?
  instructions    String?
  points          Int               @default(10)
  durationMinutes Int?              @map("duration_minutes")
  minAge          Int?              @default(9) @map("min_age")
  maxAge          Int?              @default(14) @map("max_age")
  difficulty      String            @default("easy")
  activityType    String            @default("catalog") @map("activity_type")
  isPublic        Boolean           @default(true) @map("is_public")
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime?         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  partnerId       String?           @map("partner_id") @db.Uuid
  imageUrl        String?           @map("image_url")
  catalogStatus   String            @default("published") @map("catalog_status")
  proofRequired   Boolean           @default(false) @map("proof_required")
  partnerEligible Boolean           @default(true) @map("partner_eligible")
  category        ActivityCategory? @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  creator         Profile?          @relation("ActivityCreatedBy", fields: [createdBy], references: [id], onUpdate: NoAction)
  partner         Partner?          @relation(fields: [partnerId], references: [id], onUpdate: NoAction)
  childActivities ChildActivity[]
  duos            DuoChallenge[]
  rituals         FamilyRitual[]
  sponsoredBy     PartnerOffer[]    @relation("OfferActivity")
  triggeredOffers PartnerOffer[]    @relation("OfferTriggerActivity")
  reports         ActivityReport[]

  @@map("activities")
}

model ActivityReport {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId String    @map("activity_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  reason     String
  details    String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolution String?
  activity   Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  parent     Profile?  @relation(fields: [parentId], references: [id], onUpdate: NoAction)

  @@map("activity_reports")
}

model ChildActivity {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId         String    @map("child_id") @db.Uuid
  activityId      String    @map("activity_id") @db.Uuid
  status          String    @default("available")
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(6)
  validatedAt     DateTime? @map("validated_at") @db.Timestamptz(6)
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz(6)
  validatedBy     String?   @map("validated_by") @db.Uuid
  rejectionReason String?   @map("rejection_reason")
  earnedPoints    Int?      @default(0) @map("earned_points")
  childNote       String?   @map("child_note")
  parentNote      String?   @map("parent_note")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  proofUrl        String?   @map("proof_url")
  proofType       String?   @map("proof_type")
  assignedBy      String?   @map("assigned_by") @db.Uuid
  assignedByRole  String?   @map("assigned_by_role")
  scheduledFor    DateTime? @map("scheduled_for") @db.Date
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  recurrenceType  String?   @default("none") @map("recurrence_type")
  recurrenceDays  Int[]     @map("recurrence_days")
  child           Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  activity        Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  assigner        Profile?  @relation("AssignedBy", fields: [assignedBy], references: [id], onUpdate: NoAction)
  validator       Profile?  @relation("ValidatedBy", fields: [validatedBy], references: [id], onUpdate: NoAction)

  @@index([childId, status], map: "child_activities_child_status_idx")
  @@map("child_activities")
}

// ─── Récompenses & gamification ──────────────────────────────────────────────

model Reward {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId       String?         @map("parent_id") @db.Uuid
  childId        String?         @map("child_id") @db.Uuid
  title          String
  description    String?
  requiredPoints Int             @map("required_points")
  rewardType     String          @default("custom") @map("reward_type")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rewardCategory String?         @map("reward_category")
  partnerOfferId String?         @map("partner_offer_id") @db.Uuid
  imageUrl       String?         @map("image_url")
  sourceRewardId String?         @map("source_reward_id") @db.Uuid
  parent         Profile?        @relation(fields: [parentId], references: [id], onDelete: Cascade)
  sourceReward   Reward?         @relation("RewardSource", fields: [sourceRewardId], references: [id], onUpdate: NoAction)
  copies         Reward[]        @relation("RewardSource")
  child          Child?          @relation(fields: [childId], references: [id], onDelete: Cascade)
  partnerOffer   PartnerOffer?   @relation("RewardOffer", fields: [partnerOfferId], references: [id], onUpdate: NoAction)
  requests       RewardRequest[]
  offerReward    PartnerOffer[]  @relation("OfferReward")

  @@map("rewards")
}

model RewardRequest {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId     String       @map("child_id") @db.Uuid
  rewardId    String       @map("reward_id") @db.Uuid
  status      String       @default("pending")
  requestedAt DateTime?    @default(now()) @map("requested_at") @db.Timestamptz(6)
  approvedAt  DateTime?    @map("approved_at") @db.Timestamptz(6)
  rejectedAt  DateTime?    @map("rejected_at") @db.Timestamptz(6)
  handledBy   String?      @map("handled_by") @db.Uuid
